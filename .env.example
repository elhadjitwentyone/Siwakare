# --- Obligatoires (déjà en place) ---
ADMIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=owner/nom-du-repo
GITHUB_BRANCH=main

# --- Optionnel : redéploiement auto si le CODE change (pas le contenu) ---
