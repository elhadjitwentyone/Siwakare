# --- Obligatoires (déjà en place) ---
ADMIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=owner/nom-du-repo
GITHUB_BRANCH=main

# --- Notification de commande (bouton "Commander") ---
# Clé API Resend (resend.com > API Keys)
RESEND_API_KEY=
# Adresse email qui reçoit chaque notification de commande
ORDER_NOTIFICATION_EMAIL=

# --- Optionnel : redéploiement auto si le CODE change (pas le contenu) ---
DEPLOY_HOOK_URL=

# --- Tracking (ajouté) : laisser vide = le script ne se charge pas du tout ---
# ID du Meta Pixel (Meta Events Manager > Datasets)
NEXT_PUBLIC_META_PIXEL_ID=2922117857988895
# ID de mesure GA4, ex: G-XXXXXXXXXX (Google Analytics > Admin > Flux de données)
NEXT_PUBLIC_GA_ID=

# --- Envoi quotidien des commandes livrées à Meta (cron Vercel, /api/cron/delivered) ---
# Secret envoyé par Vercel dans l'en-tête Authorization du cron
CRON_SECRET=
# Token Conversions API (Meta Events Manager > Paramètres du dataset)
META_CAPI_ACCESS_TOKEN=
# Intégration Notion (lecture + mise à jour de la base Commandes Siwakare)
NOTION_TOKEN=
NOTION_DATABASE_ID=
